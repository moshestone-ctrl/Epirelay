# Paste your two Supabase values here (README → Step 3), save, then restart `npx expo start`.
# Find them in Supabase: your project → Connect button (top of the page) → "Mobile" / Expo.
#
# These two values are designed to live inside the app and are safe to ship.
# NEVER put the "secret" or "service_role" key in this file.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_yours_here
